# 本地开发环境（已入库：不含任何密钥，可安全提交）
#
# 2026-10-12 起指向本地 BFF（server/）—— 这是「本地优先」决策的落地：
# 暂时没有域名，dev 直接打本机的 BFF，`npm run dev:server` 起服务即可联调。
# 若只想看纯前端骨架（不打后端），把下面这行清空即可。
VITE_API_BASE_URL=http://127.0.0.1:8787

VITE_APP_ENV=development
VITE_FLAG_STUDIO=on
VITE_FLAG_ASSETS=on
VITE_FLAG_DISCOVER=on
VITE_FALLBACK_POLL_MS=3000
