# ============================================================================
# Provider 接入配置（服务端专用）
#
# 用法：
#   1. 复制本文件为 .env.provider        ← 这个真实文件已被 .gitignore 忽略
#   2. 填入下面的 PROVIDER_BASE_URL 与 PROVIDER_API_KEY
#   3. 运行  npm run provider:check      自检（不会打印明文 Key）
#
# ⚠️⚠️ 安全红线（对应风险 R13）：
#   这些变量**没有 VITE_ 前缀**，因此不会被注入前端 bundle。
#   绝对不要为了「方便」改成 VITE_PROVIDER_API_KEY —— VITE_* 会被打包进
#   前端产物，任何人打开 DevTools 或直接下载 JS 都能看到 Key，等同于公开。
#   Key 只允许存在于 BFF 进程的内存与部署平台的密钥管理服务中。
# ============================================================================

# ---------------------------------------------------------------- 必填
# Provider 的 API 基址（不含结尾斜杠），例如 https://api.example-provider.com
PROVIDER_BASE_URL=

# Provider 的 API Key。只填在 .env.provider 里，不要提交、不要贴进任何文档
PROVIDER_API_KEY=

# ---------------------------------------------------------------- 可选
# 供应商标识，用于日志与 Model Registry 展示
PROVIDER_ID=generic-http
PROVIDER_DISPLAY_NAME=通用 HTTP Provider

# 三个路径模板。{id} 会被替换为厂商返回的任务 ID
PROVIDER_SUBMIT_PATH=/v1/generations
PROVIDER_POLL_PATH=/v1/generations/{id}
PROVIDER_CANCEL_PATH=/v1/generations/{id}/cancel

# 轮询间隔与单任务超时（毫秒）
PROVIDER_POLL_INTERVAL_MS=2000
PROVIDER_TIMEOUT_MS=300000

# 厂商错误码 → 平台错误码的显式映射（JSON）。
# 优先级高于内置规则，用于修正那些「厂商码看起来像参数错误、实际是内容拦截」的坑。
# 可选值：CONTENT_BLOCKED_BY_PROVIDER | PROVIDER_TIMEOUT | PROVIDER_ERROR
#         | PROVIDER_UNAVAILABLE | RATE_LIMITED | INVALID_ARGUMENT
# 示例：
# PROVIDER_ERROR_MAP={"1001":"CONTENT_BLOCKED_BY_PROVIDER","4001":"RATE_LIMITED","5003":"PROVIDER_UNAVAILABLE"}

# ---------------------------------------------------------------- stub 故障注入（无需 Key）
# 未配置 Key 时 BFF 以 stub 模式启动，用这三项模拟真实世界的不确定性。
# 它们只在本地生效，不会影响真实 Provider。
STUB_DURATION_MS=6000
STUB_FAIL_RATE=0
STUB_BLOCK_RATE=0
