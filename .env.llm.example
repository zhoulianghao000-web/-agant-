# ============================================================================
# LLM 配置（服务端专用）—— 提示词增强 / 技能体系的后端
#
# 与 .env.provider 的关系：**两者是不同的东西，不要合并**
#   .env.provider = 生成能力供应商（文生图 / 图生视频），按张/秒计费
#   .env.llm      = 语言模型（提示词增强、技能包、内容理解），按 token 计费
# 它们的 Key、配额、限流、失败语义都不同。混在一起后，
# 「换一个 LLM」会动到生成链路，「生成超时」会污染 LLM 的错误统计。
#
# 用法：
#   1. 复制本文件为 .env.llm   ← 真实文件已被 .gitignore 忽略
#   2. 填入 LLM_API_KEY
#   3. 运行  npm run llm:check    自检（不会打印明文 Key）
#
# ⚠️ 安全红线（同 R13）：无 VITE_ 前缀，绝不注入前端 bundle。
# ============================================================================

# ---------------------------------------------------------------- 必填
LLM_API_KEY=

# ---------------------------------------------------------------- 可选
# 供应商标识。当前支持 deepseek（OpenAI 兼容）
LLM_PROVIDER=deepseek

# API 基址（不含结尾斜杠）。DeepSeek 为 https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com

# 默认模型。
# ⚠️ 实测（2026-10-12）：本账号 `GET /models` 只返回 deepseek-flash 与 deepseek-v4-pro，
#    **没有 deepseek-chat** —— 填不存在的模型会直接 400。
#    换模型前先 `curl -H "Authorization: Bearer $KEY" https://api.deepseek.com/models` 确认。
LLM_MODEL=deepseek-flash

# 单次请求超时（毫秒）—— 提示词增强是**同步交互**，用户在前端等着，
# 所以必须远小于生成任务的超时（生成是异步的，等 5 分钟无所谓）
LLM_TIMEOUT_MS=30000

# 单次调用的输出上限（token）。
# ⚠️⚠️ 这个值**必须包含思维链预算**。deepseek-flash 是推理模型：
#     实测「一只猫」→ reasoning_tokens=252、最终答案仅 61 token（思维链占输出约 80%）。
#     若设成 300，整个预算会被思维链吃光，返回 content="" 且 finish_reason="length"，
#     看起来像「模型什么都没返回」。适配层已把它固化为
#     LLM_TRUNCATED_BY_TOKEN_LIMIT 错误（不会静默返回空串），但根因还是要靠这个值调够。
LLM_MAX_TOKENS=2000
