# ============================================================================
# LLM 配置（服务端专用）—— 提示词增强 / 技能体系的后端
#
# 与 .env.provider 的关系：**两者是不同的东西，不要合并**
#   .env.provider = 生成能力供应商（文生图 / 图生视频），按张/秒计费、异步轮询
#   .env.llm      = 语言模型（提示词增强、技能包），按 token 计费、同步问答
# 它们的 Key、配额、限流、失败语义都不同。混在一起后，
# 「换一个语言模型」会动到生成链路，「生成超时」会污染 LLM 的错误统计。
#
# 用法：
#   1. 复制本文件为 .env.llm   ← 真实文件已被 .gitignore 忽略
#   2. 填入你要用的 provider 的 API_KEY
#   3. 运行  npm run llm:check    自检（不会打印明文 Key）
#
# ⚠️ 安全红线（同 R13）：所有变量**无 VITE_ 前缀**，绝不注入前端 bundle。
#
# 命名规则：<PROVIDER 大写>_BASE_URL / _API_KEY / _MODEL / _TEMPERATURE
# 切换 provider 只改 LLM_PROVIDER 一行，不动 Key —— 这也是不用扁平 LLM_* 命名的理由。
# ============================================================================

# ---------------------------------------------------------------- 选择
# 要展示哪些 provider（逗号分隔）。声明式：新增一个时「该填哪些变量」会直接
# 出现在 /v1/llm/status 里，而不是等调用失败才发现漏配。
LLM_PROVIDERS=deepseek,kimi

# 当前启用哪一个
LLM_PROVIDER=deepseek

# ---------------------------------------------------------------- DeepSeek
# 提示词增强约 2.2s，明显快于 Kimi，适合做默认。
# ⚠️ 实测 2026-10-12：本账号 `GET /models` 只返回 deepseek-flash 与 deepseek-v4-pro，
#    **没有 deepseek-chat** —— 填了会直接 400。换模型前先自查：
#    curl -H "Authorization: Bearer $KEY" https://api.deepseek.com/models
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.8

# ---------------------------------------------------------------- Kimi (Moonshot)
# ⚠️ 三个必须知道的约束（均已实测）：
#   1. **temperature 只能为 1**，传 0.8 直接 400：
#      "invalid temperature: only 1 is allowed for this model"
#      —— 这就是温度必须做 profile 级配置、不能跨 provider 共用默认值的原因。
#   2. 提示词增强耗时（4 次采样）：22.2s / 2.27s / 2.35s / 2.40s
#      ⇒ 典型值约 2.4s，但存在 22s 的**离群值**。
#      对照 DeepSeek（3 次采样）：1.54s / 3.04s / 4.11s，波动更大。
#      ⚠️ 两者**处于同一量级**，不能靠延迟选默认值 —— 应看成本、质量与稳定性。
#      （最初用单次 22.2s 得出「Kimi 慢 10 倍」是错的：单样本不足以定结论。）
#   3. 思维链占输出：Kimi 72%–79%（稳定）；DeepSeek 41%–88%（波动大）。
#      两者都全部计入费用。Kimi 在成本可预测性上更好，DeepSeek 在峰值成本上可能更低。
# 另：api.moonshot.cn 可用；api.moonshot.ai 对国内账号返回 401。
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
KIMI_TEMPERATURE=1

# ---------------------------------------------------------------- 公共默认
# 这两项对所有 provider 语义一致，所以可以共享；
# 也可用 <PROVIDER>_TIMEOUT_MS / <PROVIDER>_MAX_TOKENS 单独覆盖。
#
# max_tokens 必须包含**思维链**预算：推理模型下设小了，整个预算会被思维链吃光，
# 返回 content="" 且 finish_reason="length"（已固化为 LLM_TRUNCATED_BY_TOKEN_LIMIT，
# 不会静默返回空串）。实测思维链占总输出 79%（DeepSeek）～93%（Kimi）。
LLM_TIMEOUT_MS=45000
LLM_MAX_TOKENS=2000
