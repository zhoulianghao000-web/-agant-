# ============================================================================
# 环境变量清单（三套环境共用此模板；对应实施计划任务 0.6「三套环境」）
#
#   dev       npm run dev                  读取 .env.development（已入库，无密钥）
#   staging   npm run build:staging        读取 .env.staging（不入库，由 CI Secret 注入）
#   prod      npm run build                读取 .env.production（不入库，由 CI Secret 注入）
#
# ⚠️ 红线：VITE_* 变量会被打包进前端 bundle，**任何人可见**。
#    - 可以放：API 基址、功能开关、埋点 appId、CDN 域名
#    - 绝不可放：模型 Provider 的 API Key、数据库口令、任何服务端凭证
#    Key 只存在于 BFF 侧（见 阶段0-Provider接入执行包-v1.md §4）
# ============================================================================

# ---- 通用 ----
# BFF 基址。开发期为空表示走调试台的 mock 引擎
VITE_API_BASE_URL=
# 环境标识，仅用于埋点与调试面板展示，代码中不得据此写业务分支
VITE_APP_ENV=development
# 功能开关：M1/M2/M3 模块级开关，用于故障时单独回滚某模块（对应风险 R12）
VITE_FLAG_STUDIO=on
VITE_FLAG_ASSETS=on
VITE_FLAG_DISCOVER=on
# SSE 不可用时的轮询间隔（毫秒）
VITE_FALLBACK_POLL_MS=3000

# ---- staging 建议值 ----
# VITE_API_BASE_URL=https://staging-api.<your-domain>
# VITE_APP_ENV=staging

# ---- production 建议值 ----
# VITE_API_BASE_URL=https://api.<your-domain>
# VITE_APP_ENV=production
